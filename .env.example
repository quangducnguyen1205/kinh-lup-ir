# ===== Shared PostgreSQL / Supabase =====
# Shared Pooler — Session mode (canonical connection for local development).
# Repo hiện là private; credential này là shared dev credential và có thể rotate khi cần.
#
# Crawler / Python connection string:
DATABASE_URL=postgresql://postgres.uxhzigjvjoygcqadvydo:kinhlup123%40@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Spring Boot JDBC connection:
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.uxhzigjvjoygcqadvydo
SPRING_DATASOURCE_PASSWORD=kinhlup123@

# ===== Backend =====
BACKEND_PORT=8080
LUCENE_INDEX_DIR=./data/lucene-index

# ===== Frontend =====
# Frontend calls Backend API only. It must not connect directly to PostgreSQL.
VITE_API_BASE_URL=http://localhost:8080

# ===== Crawler =====
CRAWLER_START_URL=https://hust.edu.vn/
CRAWLER_ALLOWED_DOMAIN=hust.edu.vn
# Optional. Max responses per crawl run (safety cap for local runs). Default 50; 0 = no cap.
CRAWLER_MAX_PAGES=50
